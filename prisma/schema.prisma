generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dietas {
  id_dieta            Int               @id
  id_etapa            Int
  porcentaje_proteina Decimal?          @db.Decimal(5, 2)
  porcentaje_energia  Decimal?          @db.Decimal(5, 2)
  porcentaje_fibra    Decimal?          @db.Decimal(5, 2)
  suplementos         String?
  etapas_desarrollo   etapas_desarrollo @relation(fields: [id_etapa], references: [id_etapa], onDelete: Cascade, onUpdate: NoAction)
}

model especies {
  id_especie        Int                 @id
  nombre            String              @db.VarChar(50)
  tipo              String?             @db.VarChar(20)
  etapas_desarrollo etapas_desarrollo[]
}

model etapas_desarrollo {
  id_etapa     Int      @id
  id_especie   Int
  nombre_etapa String   @db.VarChar(50)
  edad_inicio  Int
  edad_fin     Int
  descripcion  String?
  dietas       dietas[]
  especies     especies @relation(fields: [id_especie], references: [id_especie], onDelete: Cascade, onUpdate: NoAction)
}

